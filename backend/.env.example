# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ───────────────────────────────────────────────────────────────────
# Get your connection string from https://cloud.mongodb.com
MONGO_URI=mongodb://localhost:27017/ai_personal_assistant

# ─── Google Gemini AI ──────────────────────────────────────────────────────────
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Firebase Admin SDK ────────────────────────────────────────────────────────
# Download serviceAccountKey.json from Firebase Console:
# Project Settings → Service Accounts → Generate new private key
# Then paste the values here (or use the JSON file path approach in server.js)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Frontend URL (adjust if you deploy the frontend)
FRONTEND_URL=http://localhost:5173
